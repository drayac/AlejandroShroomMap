POSTGRES_PASSWORD=change-me-to-something-random
# "passphrase:Display Name,passphrase2:Other Name" - each passphrase maps to
# whoever is credited as "added_by" for mushrooms submitted with it.
ADD_LEAF_PASSPHRASES=change-me:Alejandro

# Free Google AI Studio API keys (aistudio.google.com/apikey - any Google
# account, no credit card) for the automatic mushroom identification. Comma-separate
# several keys/accounts to pool their daily free quotas together.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite
# Conservative guess at a free-tier key's daily request budget; check
# ai.google.dev/gemini-api/docs/rate-limits for the current number and adjust.
# This app counts only its OWN calls. If these same keys are also used by another
# app (e.g. the Rock Map or Plant Map), that app's calls are invisible here - split the budget
# between the two (e.g. 20 each when the keys allow 40/day) so together they stay
# under Google's real limit.
# Split of the ONE shared key (40/day), from 2026-10-04 until further notice:
#   Shroom 25, Animal 6, Plant 6, Rock 3. Keep the four .env files summing to 40.
GEMINI_DAILY_LIMIT_PER_KEY=25
